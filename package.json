{
  "name": "retro-bench",
  "version": "1.0.0",
  "description": "Retro Bench: offline pinouts and quick reference for 8-bit computer repair",
  "scripts": {
    "build": "tailwindcss -i src/input.css -o dist/app.css --minify && node scripts/build-sw-manifest.mjs",
    "watch": "tailwindcss -i src/input.css -o dist/app.css --watch",
    "icons": "node scripts/make-icons.mjs"
  },
  "license": "CC-BY-4.0",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "private": true
}
